[sub_resource type="GDScript" id="GDScript_8as4d"]
script/source = "extends Panel
@onready var outer_info_panel: Panel = $\".\"
@onready var inner_panel: Panel = $InnerPanel
@onready var auto_hiding: Label = $\"InnerPanel/Auto Hiding\"

func _ready() -> void:
	outer_info_panel.show()
	await get_tree().create_timer(1.0).timeout
	auto_hiding.text = \"Auto-hiding in \" + str(3)
	await get_tree().create_timer(1.0).timeout
	auto_hiding.text = \"Auto-hiding in \" + str(2)
	await get_tree().create_timer(1.0).timeout
	auto_hiding.text = \"Auto-hiding in \" + str(1)
	await get_tree().create_timer(1.0).timeout
	outer_info_panel.hide()
	pass
"

